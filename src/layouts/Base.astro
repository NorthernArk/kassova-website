---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import JsonLd from '../components/JsonLd.astro';
import { NAV, SITE, absolute } from '../site';
import { CSP } from '../csp';
import { FEATURES } from '../data/features';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  published?: string;
  modified?: string;
}
const { title, description, type = 'website', jsonLd = [], noindex = false, published, modified } = Astro.props;
const path = Astro.url.pathname;
const canonical = absolute(path);
const fullTitle = path === '/' ? `${SITE.name}. ${SITE.tagline} ${SITE.descriptor}` : `${title} | ${SITE.name}`;
const year = new Date().getUTCFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Kassova insights" href="/rss.xml" />
    <meta name="theme-color" content="#151a21" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary" />
    {jsonLd.map((d) => <JsonLd data={d} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="brand" href="/" aria-label="Kassova home"><Logo size={30} /><span>Kassova</span></a>
        <nav class="site-nav" aria-label="Main">
          {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a class="button" href="/demo/">Request a demo</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <div class="cols">
          <div>
            <a class="brand footer-brand" href="/"><Logo size={26} reversed /><span>Kassova</span></a>
            <p class="tag">{SITE.tagline}</p>
            <p>{SITE.descriptor}.</p>
          </div>
          <div>
            <h2>Features</h2>
            <ul>{FEATURES.map((f) => <li><a href={`/features/${f.slug}/`}>{f.title}</a></li>)}</ul>
          </div>
          <div>
            <h2>Kassova</h2>
            <ul>
              <li><a href="/insights/">Insights</a></li>
              <li><a href="/demo/">Request a demo</a></li>
              <li><a href="/waitlist/">Join the waitlist</a></li>
              <li><a href="/contact/">Talk to us</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/rss.xml">RSS</a></li>
            </ul>
          </div>
        </div>
        <p class="fine">&copy; {year} Kassova. Examples on this site use synthetic data only.</p>
      </div>
    </footer>
  </body>
</html>
