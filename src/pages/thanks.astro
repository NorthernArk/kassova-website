---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" description="Your request reached Kassova. A person reads every request and replies to the email address you gave." noindex>
  <section class="hero shell prose">
    <p class="eyebrow">Received</p>
    <h1>Thank you. Your request is with us.</h1>
    <p class="lede">A person reads every request and will reply to the email you gave. Nothing else will be sent to you.</p>
    <div class="actions">
      <a class="button secondary" href="/insights/">Read the insights</a>
      <a class="button secondary" href="/features/">See the features</a>
    </div>
  </section>
</Base>
