---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
---
<Base title="Page not found" description="The page you asked for is not on kassova.com. Start from the features or the insights instead." noindex>
  <section class="hero shell prose">
    <p class="eyebrow">Not found</p>
    <h1>That page is not here.</h1>
    <p class="lede">It may have moved. The <a href="/features/">features</a> and <a href="/insights/">insights</a> are good places to start.</p>
  </section>
  <div class="shell"><Cta /></div>
</Base>
