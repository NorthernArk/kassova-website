---
import Base from '../layouts/Base.astro';
---
<Base title="Your request was not sent" description="The Kassova form could not accept your request. Check the required fields and send it again." noindex>
  <section class="hero shell prose">
    <p class="eyebrow">Not sent</p>
    <h1>Your request did not reach us.</h1>
    <p class="lede">Either a field was missing or too long, or our intake was briefly unavailable. Nothing was stored.</p>
    <p>Please go back, check the name, work email and consent box, and send it again. If it fails twice, try again later.</p>
    <div class="actions">
      <a class="button" href="/demo/">Request a demo</a>
      <a class="button secondary" href="/contact/">Talk to us</a>
    </div>
  </section>
</Base>
